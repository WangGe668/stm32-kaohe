{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: OpenOCD: Flash project (DAPLink)",
      "type": "process",
      "command": "E:\\openocd-v0.12.0-i686-w64-mingw32\\bin\\openocd.exe",
      "args": [
        "-s",
        "E:\\openocd-v0.12.0-i686-w64-mingw32\\share\\openocd\\scripts",
        "-f",
        "interface/stlink.cfg",
        "-c",
        "transport select hla_swd",
        "-c",
        "adapter speed 2000",
        "-f",
        "target/stm32f4x.cfg",
        "-c",
        "program {${command:cmake.buildDirectory}/kaohe.elf} verify reset exit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": true
      }
    }
  ]
}